# Copy to .env (or set as a real system environment variable) and fill in.
# GameForge Studio reads ANTHROPIC_API_KEY from the environment — it does not read .env
# files automatically. Either export the var yourself before running, or use a tool
# like `dotenv-cli` / `dotenvx` if you prefer a .env-based workflow.

ANTHROPIC_API_KEY=

# Optional — only needed for `node src/cli.js narrate` or `generate --narrate`.
# Get a key from https://elevenlabs.io/ (profile icon top-right > API keys).
# Starts with a mix of letters/numbers, NOT "sk-ant-..." (that prefix is an
# Anthropic key, a different service — don't reuse the key above here).
ELEVENLABS_API_KEY=
